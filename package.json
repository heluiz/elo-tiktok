{
  "name": "elo-tiktok",
  "version": "0.2.2",
  "private": true,
  "description": "Análise e administração local dos relacionamentos da sua conta TikTok.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:connection": "node scripts/test-connection-ui.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": { "idb": "8.0.3", "preact": "10.29.8" },
  "devDependencies": {
    "@babel/core": "7.29.7", "@preact/preset-vite": "2.10.6",
    "fake-indexeddb": "6.2.5", "happy-dom": "21.0.4", "playwright": "1.64.1",
    "typescript": "5.9.3", "vite": "7.3.6", "vitest": "4.1.11", "wxt": "0.21.4"
  }
}
